# Required for room creation and joining.
# You can provide either the websocket URL or the HTTPS API URL.
# If only one is set, the app derives the other automatically.
LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional shared secrets
JWT_SECRET=local-development-jwt-secret

# Use an external MongoDB URI for Vercel deployments.
# Local example:
# MONGODB_URI=mongodb://localhost:27017/livekit_meeting
MONGODB_URI=mongodb+srv://username:password@cluster.example/livekit_meeting?retryWrites=true&w=majority

# Optional app settings
NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=/api/connection-details
NEXT_PUBLIC_SHOW_SETTINGS_MENU=false
